// nginx·backend가 syslog(UDP, RFC3164)로 보낸 로그를 받아 Loki로 보낸다.
// Docker API에는 접근하지 않는다. syslog 태그(nginx, backend)를 service 라벨로 쓴다.

loki.source.syslog "taskflow" {
  listener {
    address       = "0.0.0.0:5140"
    protocol      = "udp"
    syslog_format = "rfc3164"
  }

  relabel_rules = loki.relabel.taskflow.rules
  forward_to    = [loki.write.local.receiver]
}

loki.relabel "taskflow" {
  forward_to = []

  rule {
    source_labels = ["__syslog_message_app_name"]
    regex         = "nginx|backend"
    action        = "keep"
  }

  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "service"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
