{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {"id": 1, "type": "row", "title": "운영 요약", "collapsed": false, "panels": [], "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}},
    {"id": 2, "type": "stat", "title": "Backend UP", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(up{job=\"taskflow\"})"}], "gridPos": {"h": 5, "w": 4, "x": 0, "y": 1}},
    {"id": 3, "type": "timeseries", "title": "HTTP p95", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "gridPos": {"h": 5, "w": 4, "x": 4, "y": 1}},
    {"id": 4, "type": "timeseries", "title": "HTTP 5xx", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))"}], "gridPos": {"h": 5, "w": 4, "x": 8, "y": 1}},
    {"id": 5, "type": "stat", "title": "Outbox 최장 대기", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(outbox_oldest_processable_age_seconds) or vector(0)"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "gridPos": {"h": 5, "w": 4, "x": 12, "y": 1}},
    {"id": 6, "type": "timeseries", "title": "Gemini 실패 (10m)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (feature, error_code) (increase(gemini_calls_total{outcome=\"failure\"}[10m]))", "legendFormat": "{{feature}} / {{error_code}}"}], "gridPos": {"h": 5, "w": 4, "x": 16, "y": 1}},
    {"id": 7, "type": "stat", "title": "Hikari pending", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(hikaricp_connections_pending) or vector(0)"}], "gridPos": {"h": 5, "w": 4, "x": 20, "y": 1}},

    {"id": 8, "type": "row", "title": "사용자·이용", "collapsed": false, "panels": [], "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6}},
    {"id": 9, "type": "stat", "title": "Google 가입 사용자", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(taskflow_google_users_registered)"}], "gridPos": {"h": 6, "w": 4, "x": 0, "y": 7}},
    {"id": 10, "type": "stat", "title": "Google 신규 사용자 (24h)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(taskflow_google_users_created_24h)"}], "gridPos": {"h": 6, "w": 4, "x": 4, "y": 7}},
    {"id": 11, "type": "stat", "title": "활성 DEMO 세션", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(taskflow_demo_sessions_active)"}], "gridPos": {"h": 6, "w": 4, "x": 8, "y": 7}},
    {"id": 12, "type": "stat", "title": "DEMO 시작 (24h / 7d)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(demo_sessions_started_total[24h]))", "legendFormat": "24h"}, {"refId": "B", "expr": "sum(increase(demo_sessions_started_total[7d]))", "legendFormat": "7d"}], "gridPos": {"h": 6, "w": 5, "x": 12, "y": 7}},
    {"id": 13, "type": "timeseries", "title": "DEMO Task 생성", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(demo_task_creations_total[1h]))", "legendFormat": "1h"}], "gridPos": {"h": 6, "w": 7, "x": 17, "y": 7}},

    {"id": 14, "type": "row", "title": "Calendar·Outbox", "collapsed": true, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13}, "panels": [
      {"id": 15, "type": "timeseries", "title": "Outbox 처리율", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (outcome, reason) (rate(outbox_processed_total[5m]))", "legendFormat": "{{outcome}} / {{reason}}"}], "gridPos": {"h": 7, "w": 8, "x": 0, "y": 0}},
      {"id": 16, "type": "timeseries", "title": "Google 미연결 skip 비율", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(outbox_processed_total{outcome=\"skipped\",reason=\"no_google_link\"}[5m]))"}], "gridPos": {"h": 7, "w": 4, "x": 8, "y": 0}},
      {"id": 17, "type": "stat", "title": "처리 가능 Outbox 최장 대기", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(outbox_oldest_processable_age_seconds) or vector(0)"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "gridPos": {"h": 7, "w": 4, "x": 12, "y": 0}},
      {"id": 18, "type": "stat", "title": "Cleanup 실패 (15m)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(increase(demo_cleanup_failures_total[15m])) or vector(0)"}], "gridPos": {"h": 7, "w": 4, "x": 16, "y": 0}},
      {"id": 19, "type": "stat", "title": "만료 DEMO 최장 잔류", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(demo_oldest_expired_age_seconds) or vector(0)"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "gridPos": {"h": 7, "w": 4, "x": 20, "y": 0}}
    ]},

    {"id": 20, "type": "row", "title": "Gemini·Cache", "collapsed": true, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "panels": [
      {"id": 21, "type": "timeseries", "title": "Gemini 호출", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (feature) (rate(gemini_calls_total[5m]))", "legendFormat": "{{feature}}"}], "gridPos": {"h": 7, "w": 8, "x": 0, "y": 0}},
      {"id": 22, "type": "timeseries", "title": "Gemini 성공·실패", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (feature, outcome) (rate(gemini_calls_total[5m]))", "legendFormat": "{{feature}} / {{outcome}}"}], "gridPos": {"h": 7, "w": 8, "x": 8, "y": 0}},
      {"id": 23, "type": "timeseries", "title": "Gemini p95", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, feature) (rate(gemini_calls_seconds_bucket[5m])))", "legendFormat": "{{feature}}"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "gridPos": {"h": 7, "w": 8, "x": 16, "y": 0}},
      {"id": 24, "type": "stat", "title": "Gemini 429 분류 (1h)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (error_code) (increase(gemini_calls_total{outcome=\"failure\",error_code=~\"LLM_QUOTA_EXHAUSTED|LLM_RATE_LIMITED_TEMPORARY|LLM_429_UNKNOWN\"}[1h]))", "legendFormat": "{{error_code}}"}], "gridPos": {"h": 7, "w": 12, "x": 0, "y": 7}},
      {"id": 25, "type": "timeseries", "title": "Cache 처리율", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (feature, outcome) (rate(taskflow_cache_operations_total[5m]))", "legendFormat": "{{feature}} / {{outcome}}"}], "gridPos": {"h": 7, "w": 12, "x": 12, "y": 7}}
    ]},

    {"id": 26, "type": "row", "title": "Backend runtime", "collapsed": true, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15}, "panels": [
      {"id": 27, "type": "timeseries", "title": "Process CPU", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "process_cpu_usage"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []}, "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0}},
      {"id": 28, "type": "timeseries", "title": "JVM heap", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})"}, {"refId": "B", "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}, "gridPos": {"h": 7, "w": 6, "x": 6, "y": 0}},
      {"id": 29, "type": "timeseries", "title": "GC pause 평균", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(jvm_gc_pause_seconds_sum[5m])) / sum(rate(jvm_gc_pause_seconds_count[5m]))"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "gridPos": {"h": 7, "w": 6, "x": 12, "y": 0}},
      {"id": 30, "type": "timeseries", "title": "HTTP 요청률", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{status}}"}], "gridPos": {"h": 7, "w": 6, "x": 18, "y": 0}},
      {"id": 31, "type": "timeseries", "title": "Hikari connections", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "hikaricp_connections_active", "legendFormat": "active"}, {"refId": "B", "expr": "hikaricp_connections_max", "legendFormat": "max"}, {"refId": "C", "expr": "hikaricp_connections_pending", "legendFormat": "pending"}], "gridPos": {"h": 7, "w": 12, "x": 0, "y": 7}},
      {"id": 32, "type": "timeseries", "title": "Hikari timeout", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "increase(hikaricp_connections_timeout_total[5m])"}], "gridPos": {"h": 7, "w": 6, "x": 12, "y": 7}},
      {"id": 33, "type": "stat", "title": "Process uptime", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "process_uptime_seconds"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "gridPos": {"h": 7, "w": 6, "x": 18, "y": 7}}
    ]},

    {"id": 34, "type": "row", "title": "보안", "collapsed": true, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16}, "panels": [
      {"id": 35, "type": "timeseries", "title": "막힌·스캐너 경로 접근 (IP별, 5m)", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum by (ip) (count_over_time({service=\"nginx\"} | json | __error__=\"\" | ua != \"taskflow-boundary-check\" | path =~ `(?i)^/(actuator|api/admin|api/test)(/.*)?$|.*(\\.env|\\.git/|\\.php|wp-|phpmyadmin|cgi-bin|\\.\\./).*` [5m]))", "legendFormat": "{{ip}}"}], "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0}},
      {"id": 36, "type": "timeseries", "title": "401·403 (IP별, 5m)", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum by (ip, status) (count_over_time({service=\"nginx\"} | json | __error__=\"\" | ua != \"taskflow-boundary-check\" | status =~ \"401|403\" [5m]))", "legendFormat": "{{ip}} / {{status}}"}], "gridPos": {"h": 7, "w": 6, "x": 6, "y": 0}},
      {"id": 37, "type": "timeseries", "title": "요청 수 제한 429 (경로별, 5m)", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum by (path) (count_over_time({service=\"nginx\"} | json | __error__=\"\" | status = \"429\" [5m]))", "legendFormat": "{{path}}"}], "gridPos": {"h": 7, "w": 6, "x": 12, "y": 0}},
      {"id": 38, "type": "timeseries", "title": "ID 대입 404 (IP별 서로 다른 ID, 10m)", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "count by (ip) (sum by (ip, rid) (count_over_time({service=\"nginx\"} | json | __error__=\"\" | status = \"404\" | regexp `\"path\":\"/api/(?:projects|tasks)/(?P<rid>[0-9]+)` | rid != \"\" [10m])))", "legendFormat": "{{ip}}"}], "gridPos": {"h": 7, "w": 6, "x": 18, "y": 0}},
      {"id": 39, "type": "timeseries", "title": "OAuth 로그인 실패 (이유별, 1h)", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum by (reason) (count_over_time({service=\"backend\"} |~ `^WARN +\\S*GoogleOAuthController : OAuth callback failed\\. reason=[a-z_]+$` | regexp `reason=(?P<reason>[a-z_]+)$` [1h]))", "legendFormat": "{{reason}}"}], "gridPos": {"h": 7, "w": 8, "x": 0, "y": 7}},
      {"id": 40, "type": "timeseries", "title": "세션 토큰 거부 (이유별, 1h) · session_revoked = 무효화된 토큰 재사용", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum by (reason) (count_over_time({service=\"backend\"} |~ `^INFO +\\S*JwtAuthenticationFilter : Session token rejected\\. reason=[a-z_]+$` | regexp `reason=(?P<reason>[a-z_]+)$` [1h]))", "legendFormat": "{{reason}}"}], "gridPos": {"h": 7, "w": 8, "x": 8, "y": 7}},
      {"id": 41, "type": "timeseries", "title": "스캐너 User-Agent (5m)", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum by (ua) (count_over_time({service=\"nginx\"} | json | __error__=\"\" | ua =~ `(?i).*(sqlmap|nikto|nmap|masscan|zgrab|nuclei|gobuster|dirbuster|wpscan).*` [5m]))", "legendFormat": "{{ua}}"}], "gridPos": {"h": 7, "w": 8, "x": 16, "y": 7}},
      {"id": 42, "type": "logs", "title": "nginx 로그 (IP 필터: $ip)", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "{service=\"nginx\"} | json | __error__=\"\" | ip =~ \"$ip\""}], "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}, "gridPos": {"h": 10, "w": 24, "x": 0, "y": 14}}
    ]}
  ],
  "schemaVersion": 41,
  "tags": ["public-demo", "operations"],
  "templating": {"list": [{"name": "ip", "label": "IP (정규식)", "type": "textbox", "query": ".*", "current": {"text": ".*", "value": ".*"}, "hide": 0}]},
  "time": {"from": "now-6h", "to": "now"},
  "title": "TaskFlow",
  "uid": "taskflow",
  "version": 3
}
