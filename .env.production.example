GIT_SHA=replace-with-exact-git-sha
TASKFLOW_HTTP_PORT=8088
TASKFLOW_GRAFANA_PORT=3001
POSTGRES_BOOTSTRAP_PASSWORD=replace-with-random-bootstrap-password
TASKFLOW_DB_OWNER_PASSWORD=replace-with-random-owner-password
TASKFLOW_DB_APP_PASSWORD=replace-with-random-app-password
JWT_SECRET=replace-with-at-least-256-bit-random-secret
# openssl rand -base64 32 / openssl rand -hex 16. 값에 $ 를 넣지 말 것 - compose가 변수로 해석해 잘라먹는다.
TASKFLOW_TOKEN_ENC_PASSWORD=replace-with-random-token-encryption-password
TASKFLOW_TOKEN_ENC_SALT=replace-with-random-hex-salt
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8088/api/oauth/google/callback
FRONTEND_BASE_URL=http://localhost:8088
GRAFANA_ADMIN_PASSWORD=replace-with-random-grafana-password
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0/local-placeholder
GEMINI_SUMMARY_API_KEY=
GEMINI_RECOMMENDATION_API_KEY=
GEMINI_SEARCH_API_KEY=
