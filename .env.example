# 복사해서 .env 로 쓴다. .env 는 커밋되지 않는다.

# 필수 - 없으면 기동에 실패한다
JWT_SECRET=<256비트 이상 랜덤 문자열. openssl rand -base64 48>
GOOGLE_CLIENT_ID=<...>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<...>

# 선택 - 아래는 전부 기본값이 있다. 로컬에서는 그대로 두면 된다.
# DB_URL=jdbc:postgresql://localhost:5432/taskflow
# DB_USERNAME=taskflow
# DB_PASSWORD=taskflow123
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/oauth/google/callback
# FRONTEND_BASE_URL=http://localhost:3000

# 배포에서 반드시 덮는 것
# SPRING_PROFILES_ACTIVE=prod   # local 이 아니어야 /api/test/** 가 빠진다
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# LOG_LEVEL_SQL=WARN
# LOG_LEVEL_SQL_BIND=WARN

# LLM (없으면 해당 기능만 꺼진다)
# GEMINI_SUMMARY_API_KEY=
# GEMINI_RECOMMENDATION_API_KEY=
# GEMINI_SEARCH_API_KEY=
