# 복사해서 .env 로 쓴다. .env 는 커밋되지 않는다.

# 필수 - 없으면 기동에 실패한다
JWT_SECRET=<256비트 이상 랜덤 문자열. openssl rand -base64 48>
GOOGLE_CLIENT_ID=<...>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<...>
# 저장된 Google OAuth 토큰의 컬럼 암호화 키. 잃으면 기존 토큰은 영구히 복호화할 수 없다.
TOKEN_ENC_PASSWORD=<임의의 긴 랜덤 문자열. openssl rand -base64 32>
TOKEN_ENC_SALT=<hex 문자열. openssl rand -hex 16>
# 세션 쿠키의 Secure 속성. 로컬 http 에서는 false, 배포는 반드시 true.
SESSION_COOKIE_SECURE=false

# 선택 - 아래는 전부 기본값이 있다. 로컬에서는 그대로 두면 된다.
# DB_URL=jdbc:postgresql://localhost:5432/taskflow
# DB_USERNAME=taskflow
# DB_PASSWORD=taskflow123
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/oauth/google/callback
# FRONTEND_BASE_URL=http://localhost:3000
# OUTBOX_WORKER_ENABLED=true   # Google Calendar 동기화까지 확인할 때만 켠다. 기본값 false

# 배포에서 반드시 덮는 것
# SPRING_PROFILES_ACTIVE=prod   # local 이 아니어야 /api/test/** 가 빠진다
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# LOG_LEVEL_SQL=WARN
# LOG_LEVEL_SQL_BIND=WARN

# LLM (없으면 해당 기능만 꺼진다)
# GEMINI_SUMMARY_API_KEY=
# GEMINI_RECOMMENDATION_API_KEY=
# GEMINI_SEARCH_API_KEY=
